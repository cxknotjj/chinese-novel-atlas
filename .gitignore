# 输出目录（分析产物，不进仓库）
output/

# 本地密钥 / 凭据（即使当前不需要外部 API，也避免误提交）
.env
*.key

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# 章节切分中间产物
chapters/

# 系统文件
.DS_Store
Thumbs.db

# 编辑器
.vscode/
.idea/

# 原始小说文本（版权内容，绝不提交）
novals/

# 模板/地图的视觉验收临时产物（Playwright 截图、node_modules、旧版备份）
_contract/

# 本地配置（含 key），只提交 config.example.json
data/config.json

# 构建检查产物
build-check/
build-reader/

# 根目录的临时截图 / 调色试验图 / 打包文件（视觉验收残留，不属于仓库内容）
/*.png
/*.webp
/*.zip
/*.jpg
