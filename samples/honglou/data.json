  "events": [
    {
      "ch": 1,
      "title": "甄士隐梦幻识通灵",
      "summary": "甄士隐梦中听见僧道谈论通灵宝玉，醒后抱女儿英莲上街，遇僧道预言其命运。",
      "tension": 0.35,
      "entities": [
        "e_zhenshiyin",
        "e_xiangling"
      ]
    },
    {
      "ch": 2,
      "title": "冷子兴演说荣国府",
      "summary": "贾雨村在村肆遇冷子兴，借其口交代贾府谱系与现状，是全书人物关系的总纲。",
      "tension": 0.2,
      "entities": [
        "e_jiayucun",
        "e_jiamu",
        "e_baoyu",
        "e_daiyu"
      ]
    },
    {
      "ch": 3,
      "title": "林黛玉抛父进京都",
      "summary": "黛玉入贾府，初见贾母、王熙凤，与宝玉初见即觉眼熟，宝玉摔玉。",
      "tension": 0.75,
      "entities": [
        "e_daiyu",
        "e_jiamu",
        "e_baoyu",
        "e_wangxifeng"
      ]
    },
    {
      "ch": 4,
      "title": "葫芦僧乱判葫芦案",
      "summary": "贾雨村徇情枉法，放走打死冯渊的薛蟠，香菱归薛家。护官符由此引出。",
      "tension": 0.5,
      "entities": [
        "e_jiayucun",
        "e_xuepan",
        "e_xiangling"
      ]
    },
    {
      "ch": 5,
      "title": "贾宝玉神游太虚境",
      "summary": "宝玉在秦可卿房中入睡，入太虚幻境，见金陵十二钗判词，听《红楼梦曲》。全书命运的预言。",
      "tension": 0.9,
      "entities": [
        "e_baoyu",
        "e_qinkeqing",
        "e_miaoyu"
      ]
    },
    {
      "ch": 13,
      "title": "秦可卿死封龙禁尉",
      "summary": "秦可卿暴亡，贾珍极尽奢华办丧事，王熙凤协理宁国府，展露治家才干。",
      "tension": 0.85,
      "entities": [
        "e_qinkeqing",
        "e_jiazhen",
        "e_wangxifeng"
      ]
    },
    {
      "ch": 17,
      "title": "大观园试才题对额",
      "summary": "工程告竣，贾政带宝玉游园题匾，宝玉才情初显，大观园格局由此定型。",
      "tension": 0.45,
      "entities": [
        "e_baoyu",
        "e_jiazheng"
      ]
    },
    {
      "ch": 18,
      "title": "皇恩重元妃省父母",
      "summary": "元春省亲，大观园最盛之夜。元春命诸姐妹题诗，叹皇宫是「不得见人的去处」。",
      "tension": 0.8,
      "entities": [
        "e_yuanchun",
        "e_baoyu",
        "e_jiamu"
      ]
    },
    {
      "ch": 23,
      "title": "西厢记妙词通戏语",
      "summary": "宝玉与黛玉共读《西厢》，以戏文互诉心意，是二人情感最明朗的一刻。",
      "tension": 0.7,
      "entities": [
        "e_baoyu",
        "e_daiyu"
      ]
    },
    {
      "ch": 27,
      "title": "埋香冢飞燕泣残红",
      "summary": "黛玉葬花，作《葬花吟》。芒种饯花之期，也是最著名的独白段落。",
      "tension": 0.8,
      "entities": [
        "e_daiyu",
        "e_baoyu"
      ]
    },
    {
      "ch": 32,
      "title": "手足耽耽小动唇舌",
      "summary": "金钏投井事发、贾环进谗，贾政盛怒之下痛打宝玉，几至殒命。",
      "tension": 0.95,
      "entities": [
        "e_baoyu",
        "e_jiazheng",
        "e_wangfuren",
        "e_jinchuan"
      ]
    },
    {
      "ch": 40,
      "title": "史太君两宴大观园",
      "summary": "刘姥姥二进荣国府，游大观园闹出诸多笑话，是全书最热闹的喜剧段落。",
      "tension": 0.4,
      "entities": [
        "e_liulaolao",
        "e_jiamu",
        "e_wangxifeng",
        "e_daiyu"
      ]
    },
    {
      "ch": 74,
      "title": "抄检大观园",
      "summary": "王夫人下令抄检，探春怒斥，司棋被逐，晴雯被撵。大观园的秩序与人心同时崩解。",
      "tension": 0.9,
      "entities": [
        "e_tanchun",
        "e_wangfuren",
        "e_sijie",
        "e_qingwen",
        "e_xichun"
      ]
    },
    {
      "ch": 97,
      "title": "林黛玉焚稿断痴情",
      "summary": "宝玉误娶宝钗之夜，黛玉焚毁诗稿与旧帕，斩断痴情。",
      "tension": 1,
      "entities": [
        "e_daiyu",
        "e_baoyu",
        "e_baochai"
      ]
    },
    {
      "ch": 98,
      "title": "苦绛珠魂归离恨天",
      "summary": "黛玉泪尽而逝，应了「还泪」之说。宝玉痴傻，宝钗成婚。",
      "tension": 1,
      "entities": [
        "e_daiyu",
        "e_baoyu"
      ]
    },
    {
      "ch": 120,
      "title": "甄士隐详说太虚情",
      "summary": "宝玉中举后随僧道出家，贾府复起。甄士隐再出，为全书作结。",
      "tension": 0.7,
      "entities": [
        "e_baoyu",
        "e_zhenshiyin",
        "e_jialan"
      ]
    }
  ],
